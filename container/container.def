Bootstrap: docker 
From: ubuntu:26.04

%environment
	export PETSC_DIR=/petsc 
	export PETSC_ARCH=arch-linux-c-debug 
	export SLEPC_DIR=/slepc 
	export PATH=/usr/local/bin:$PATH
	export PYTHONPATH=/scvemo:$PYTHONPATH
        export LC_ALL=C.UTF-8
        export LANG=C.UTF-8

%files
    	container/requirements.txt /requirements.txt

%post
        export DEBIAN_FRONTEND=noninteractive

	apt-get update && apt-get install -y --no-install-recommends \
	git \
	python3 \
	python3-dev \
	python3-pip \
	make \
	build-essential \
	gfortran \
	curl \
	wget \
	ca-certificates \
	cmake \
	libigraph-dev \
	&& rm -rf /var/lib/apt/lists/*

	python3 -m pip install --break-system-packages \
						"setuptools<81" \
						"setuptools_scm<9" \
						wheel \
						"Cython>=3.0,<3.1" \
						"numpy==2.5.2"

	cd /
	git clone -b release https://gitlab.com/petsc/petsc.git /petsc
	cd /petsc
	git checkout v3.25.4
	./configure --with-mpi=0 --with-cc=gcc --with-cxx=g++ --with-fc=gfortran --download-f2cblaslapack
	make all check
	cd /
	export PETSC_DIR=/petsc 
	export PETSC_ARCH=arch-linux-c-debug

	# Install slepc requirements for slepc4py
	git clone -b release https://gitlab.com/slepc/slepc.git /slepc	
	cd /slepc 
	git checkout v3.25.1
	./configure
	make SLEPC_DIR=/slepc PETSC_DIR=/petsc PETSC_ARCH=arch-linux-c-debug
	cd /
	export SLEPC_DIR=/slepc

	python3 -m pip install --break-system-packages --no-build-isolation petsc4py==3.25.4
	python3 -m pip install --break-system-packages --no-build-isolation slepc4py==3.25.1
	python3 -m pip install --break-system-packages --ignore-installed packaging==25.0 wheel==0.48.0
	python3 -m pip install --break-system-packages -r requirements.txt 



