Bootstrap: docker 
From: ubuntu:22.04

%environment
	export PETSC_DIR=/petsc 
	export PETSC_ARCH=arch-linux-c-debug 
	export SLEPC_DIR=/slepc 
	export PATH=/usr/local/bin:$PATH
	export PYTHONPATH=/scvemo:$PYTHONPATH

%files 
	src/requirements.txt /requirements.txt 

%post
	apt-get update && apt-get install -y --no-install-recommends \
	git \
	python3 \
	python3-dev \
	python3-pip \
	make \
	libopenmpi-dev \
	build-essential \
	gfortran \
	curl \
	wget \
	&& rm -rf /var/lib/apt/lists/*

	python3 -m pip install --upgrade pip

	# Install petsc requirements for petsc4py
	cd /
	git clone -b release https://gitlab.com/petsc/petsc.git /petsc
	cd /petsc
	git checkout v3.23.2	
	./configure --with-cc=gcc --with-cxx=g++ --download-mpich --download-f2cblaslapack
	make all check
	cd /
	export PETSC_DIR=/petsc 
	export PETSC_ARCH=arch-linux-c-debug

	# Install slepc requirements for slepc4py
	git clone https://gitlab.com/slepc/slepc.git /slepc	
	cd /slepc 
	git checkout v3.23.1
	./configure
	make SLEPC_DIR=/slepc PETSC_DIR=/petsc PETSC_ARCH=arch-linux-c-debug
	cd /
	export SLEPC_DIR=/slepc

	pip install -r /requirements.txt 
	pip install petsc4py==3.23.2
	pip install slepc4py==3.23.1


#%runscript
